# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project Settings → Environment Variables.

# Shared driver login
APP_USERNAME=your_username_here
APP_PASSWORD=your_password_here

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`).
# Changing it signs everyone out.
SESSION_SECRET=your_long_random_secret_here
